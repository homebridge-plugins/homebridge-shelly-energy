{
  "pluginAlias": "ShellyHomeEnergy",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "customUiPath": "./lib/homebridge-ui",
  "headerDisplay": "<p align=\"center\"><img width=\"250px\" src=\"https://raw.githubusercontent.com/homebridge-plugins/homebridge-shelly-energy/latest/branding/Homebridge_x_Shelly.png\"></p><p align=\"center\">For help and support please visit our <a href=\"https://github.com/homebridge-plugins/homebridge-shelly-energy/wiki\">GitHub Wiki</a>. We hope you find this plugin useful!</p>",
  "footerDisplay": "Everything is set up on this page. Turn on **Matter** for the bridge this plugin runs on (and **HomeKit**, for running tiles).",
  "schema": {
    "type": "object",
    "required": [
      "name"
    ],
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Shelly Home Energy"
      },
      "host": {
        "title": "Shelly EM address (first start only; change it on the settings page)",
        "type": "string",
        "placeholder": "192.168.1.50"
      },
      "channel": {
        "title": "Which reading",
        "type": "string",
        "default": "auto"
      },
      "webPort": {
        "title": "Web page port (0 = no web page)",
        "type": "integer",
        "default": 8591,
        "minimum": 0,
        "maximum": 65535,
        "description": "The plugin's own page at http://<this computer>:8591/, for your home network only, behind a PIN set on the settings page."
      },
      "matterLogLevel": {
        "title": "Matter log detail",
        "type": "string",
        "default": "warn",
        "enum": [
          "error",
          "warn",
          "info",
          "debug"
        ]
      }
    }
  }
}
