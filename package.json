{
  "name": "@homebridge-plugins/homebridge-shelly-energy",
  "alias": "ShellyHomeEnergy",
  "displayName": "Homebridge Shelly Energy",
  "type": "module",
  "version": "1.1.0",
  "description": "Homebridge plugin that learns your appliances from a Shelly whole-house energy meter and shows each one in Apple Home with live watts and energy over Matter. Local only.",
  "author": "homebridge-plugins",
  "license": "MIT",
  "homepage": "https://github.com/homebridge-plugins/homebridge-shelly-energy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homebridge-plugins/homebridge-shelly-energy.git"
  },
  "bugs": {
    "url": "https://github.com/homebridge-plugins/homebridge-shelly-energy/issues"
  },
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "supports-hap",
    "supports-matter",
    "homebridge-shelly-energy",
    "homekit",
    "shelly",
    "shelly-em",
    "matter",
    "energy",
    "power",
    "appliances",
    "nilm"
  ],
  "main": "lib/index.js",
  "engines": {
    "homebridge": "^2.4.0",
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test-coverage": "npm run test -- --coverage",
    "changelog:sync": "node .github/scripts/sync-changelog.mjs"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.3.1",
    "@matter/main": "^0.18.1",
    "@matter/nodejs": "^0.18.1",
    "@project-chip/matter.js": "^0.18.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@vitest/coverage-v8": "^5.1.2",
    "ajv": "^8.20.0",
    "homebridge": "^2.5.0",
    "vitest": "^5.1.2"
  }
}
